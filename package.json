{
  "name": "games-browser-checks",
  "private": true,
  "scripts": {
    "build": "python build.py",
    "build:firebase": "python prepare_firebase.py",
    "deploy:firebase": "python prepare_firebase.py && firebase deploy --only hosting --project mdgames153",
    "emulator:auth": "firebase emulators:start --only auth --project demo-mdgames",
    "test:account": "node tests/account-ui.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:abalone": "node tests/abalone-ui.cjs",
    "test:view": "node tests/local-view-ui.cjs",
    "test:updates": "node tests/game-update-ui.cjs",
    "test:match": "node tests/match-actions-ui.cjs && node tests/match-actions-extra.cjs && node tests/match-actions-online.cjs",
    "test:continue": "node tests/continue-ui.cjs",
    "test:checkers": "node tests/checkers-ui.cjs",
    "test:overlays": "node tests/chess-overlays.cjs",
    "test:export": "node tests/export-ui.cjs",
    "test:study": "node tests/study.cjs",
    "test:room": "node tests/room-choice.cjs",
    "test:preferences": "node tests/preferences.cjs",
    "test:browser": "node tests/browser.cjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "peer": "1.0.2",
    "peerjs": "1.5.4",
    "playwright": "1.58.2"
  },
  "dependencies": {
    "firebase": "13.2.0"
  }
}
